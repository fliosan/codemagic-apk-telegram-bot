# Copy this file to .env and fill in the values:
#   cp .env.example .env
# The four REQUIRED vars are marked below — the bot refuses to start without them.

# ── Slack (Socket Mode) ────────────────────────────────────────────────
# REQUIRED. Bot User OAuth Token — api.slack.com/apps → OAuth & Permissions.
# Needs scopes: channels:history, groups:history, chat:write
SLACK_BOT_TOKEN=xoxb-...

# REQUIRED. App-Level Token with the connections:write scope —
# api.slack.com/apps → Basic Information → App-Level Tokens → Generate.
SLACK_APP_TOKEN=xapp-...

# Optional but recommended: only react to messages in this one channel
# (Slack → channel name → the C… id at the bottom of the About tab).
# Leave empty to listen in every channel the bot was invited to.
SLACK_CHANNEL_ID=

# ── Telegram ───────────────────────────────────────────────────────────
# REQUIRED. From @BotFather → /newbot (or /token for an existing bot).
TELEGRAM_BOT_TOKEN=123456789:AAE...

# REQUIRED. Where APKs get delivered. Press Start in your bot, then run:
#   python get_chat_id.py
# Positive number = private chat; negative (-100…) = group/channel.
TELEGRAM_CHAT_ID=

# ── Big APKs over 50 MB (optional, but needed for most real builds) ────
# Telegram's Bot API caps bot uploads at 50 MB. With these two values the
# bot switches to MTProto (Telethon) and uploads files up to ~800 MB as
# real, forwardable files instead of only sending the download link.
#
# Get them once at https://my.telegram.org → API development tools →
# create an app (any title, platform "Other"). They identify the *app*,
# not your account, and are used together with TELEGRAM_BOT_TOKEN above —
# the bot still uploads as itself, never as you.
# Leave both empty to stay on the Bot API and receive links for big files.
TG_API_ID=
TG_API_HASH=

# ── Codemagic (optional) ───────────────────────────────────────────────
# Only needed if artifact downloads return 401/403 — the bot then retries
# with an x-auth-token header. Codemagic → Teams → Integrations → API.
CODEMAGIC_TOKEN=
